# ==============================================================================
# Nexora B2B SaaS Platform - Environment Configuration
# Copy this file to .env and fill in your values.
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# Database Configuration (PostgreSQL)
# Set USE_SQLITE=true for instant standalone testing without PostgreSQL/Redis.
USE_SQLITE=false
POSTGRES_DB=saas_platform
POSTGRES_USER=saas_app
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Cache & Throttling (Redis)
REDIS_URL=redis://127.0.0.1:6379/1

# Stripe Billing & Subscriptions
# Set BILLING_DEMO_MODE=true to test one-click plan upgrades without real Stripe keys.
# Set BILLING_DEMO_MODE=false and populate valid Stripe test/live keys for production billing.
BILLING_DEMO_MODE=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
